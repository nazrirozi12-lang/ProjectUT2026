# Isi variabel ini di Vercel > Project > Settings > Environment Variables
# (jangan commit nilai asli)

APP_NAME="Naro Capture"
# Hasilkan lokal: php artisan key:generate --show
APP_KEY=
# Domain Vercel / domain sendiri, pakai https
APP_URL=https://nama-proyek.vercel.app

# Database eksternal (SQLite tidak persisten di Vercel). Contoh Postgres (Neon/Supabase):
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Sesi & cache memakai tabel database (migrasi sudah membuat tabelnya)
SESSION_DRIVER=database
CACHE_STORE=database

# Akun admin untuk seeder (WAJIB di production)
ADMIN_EMAIL=admin@clarahayes.com
ADMIN_PASSWORD=

# Bukti transfer disimpan di database (tabel payment_proofs) -> tidak butuh S3 / paket tambahan.
# Batas upload Vercel ~4,5 MB (validasi aplikasi: 4 MB).
PAYMENT_PROOF_DISK=database

# OPSIONAL: bila ingin memakai S3 / Cloudflare R2, ganti PAYMENT_PROOF_DISK=s3,
# jalankan `composer require league/flysystem-aws-s3-v3 "^3.0"` lalu commit composer.lock, dan isi:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
